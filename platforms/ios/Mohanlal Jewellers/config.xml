    <name>Mohanlal Jewellers</name>
    <description>Mohanlal Jewellers project.</description>
    <author email="support@logimaxindia.com" href="http://www.logimaxindia.com/">Logimax Team</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="http://localhost:8080/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <allow-intent href="whatsapp:*" />
    <allow-navigation href="*" />
    <hook src="scripts/fix-ios-signing.js" type="after_prepare" />
    <config-file parent="UIBackgroundModes" target="*-Info.plist">
        <array>
            <string>remote-notification</string>
        </array>
    </config-file>
    <config-file parent="NSCameraUsageDescription" target="*-Info.plist">
        <string>The camera is used to take photos of jewellery designs you attach to a custom order.</string>
    </config-file>
    <config-file parent="NSPhotoLibraryUsageDescription" target="*-Info.plist">
        <string>Your photo library is used to choose jewellery design images you attach to a custom order.</string>
    </config-file>
    <config-file parent="NSPhotoLibraryAddUsageDescription" target="*-Info.plist">
        <string>Photo library access is used to save product images you choose to download or share.</string>
    </config-file>
    <config-file parent="LSApplicationQueriesSchemes" platform="ios" target="*-Info.plist">
        <array>
            <string>whatsapp</string>
        </array>
    </config-file>
    <allow-intent href="itms:*" />
    <allow-intent href="itms-apps:*" />
